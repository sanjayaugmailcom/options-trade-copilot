# Environment Configuration Template
# Copy this to .env and fill in your values

# Polygon API Configuration
POLYGON_API_KEY=your_polygon_api_key_here

# TimescaleDB Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=options_db
DB_USER=postgres
DB_PASSWORD=password

# Data Ingestion Configuration
INGEST_BATCH_SIZE=1000          # Rows per batch insert
INGEST_THREADS=4                # Parallel ingestion threads
POLYGON_RATE_LIMIT_PER_MIN=120  # Polygon API rate limit

# Storage Configuration
DATA_RETENTION_DAYS=730         # Keep 2 years of detailed data
COMPRESSION_AFTER_DAYS=7        # Compress data older than 7 days

# Ingestion Tickers (comma-separated)
TICKERS=AAPL,SPY,QQQ,IWM,TLT,TSLA,NVDA,AMD,GOOGL,MSFT

# Logging
LOG_LEVEL=INFO
LOG_FILE=options_ingestion.log

# Advanced Options
ENABLE_COMPRESSION=true
ENABLE_RETENTION_POLICIES=true
PARALLEL_IMPORTS=true
